# Bu dosyayı .env olarak kopyala ve doldur. .env asla commit edilmemeli.

# Claude API - script ve metadata uretimi icin
ANTHROPIC_API_KEY=

# OmniRoute gateway (opsiyonel) - doluysa s01_script.py ANTHROPIC_API_KEY yerine
# bunu kullanir: OmniRoute'un ucretsiz model havuzu + otomatik fallback ile
# script uretimi hicbir Anthropic kredisi harcamadan calisir. Bos birakilirsa
# davranis eskisi gibi dogrudan Anthropic API'ye gider.
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://localhost:20128/v1

# YouTube Data API v3 - Google Cloud Console'dan OAuth Client ID (Desktop app) indir,
# JSON dosyasini secrets/youtube_client_secret.json olarak kaydet.
YOUTUBE_CLIENT_SECRET_FILE=secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json
